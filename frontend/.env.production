# Loaded automatically by Vite during `npm run build` (mode=production).
# Overrides .env. Values here are baked into the static bundle.
#
# Real values are injected by .github/workflows/deploy-frontend.yml from
# the FatchadAuthStack CloudFormation outputs at build time — these
# defaults are only safe fallbacks for local `npm run build` previews.

# Force the Cognito backend. Setting this to 'false' is the difference
# between "the build runs Cognito" and "the build is still in demo mode".
VITE_USE_DEMO_AUTH=false
