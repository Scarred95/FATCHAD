# Loaded automatically by Vite when running `npm run dev` (mode=development).
# Overrides .env. Values here are ONLY for local dev — they are not bundled
# into production builds (those use .env.production, then CI env vars).

# Skip Cognito entirely. The demo backend accepts AurenAdmin / test123
# and lets every flow complete locally without any AWS calls.
VITE_USE_DEMO_AUTH=true
